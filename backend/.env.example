# OpenAI API 설정
OPENAI_API_KEY=your_openai_api_key_here

# SMTP 이메일 설정
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=your_email@gmail.com
SENDER_PASSWORD=your_app_password

# 애플리케이션 설정
# 백엔드 포트 (프론트엔드가 8000 을 쓰므로 8001)
PORT=8001

# CORS 허용 주소 (쉼표 구분)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:8501,http://127.0.0.1:8501
DEBUG=False
LOG_LEVEL=INFO

# 뉴스레터 설정
NEWSLETTER_BATCH_SIZE=50
NEWSLETTER_LANGUAGE=ko

# ---------------- MySQL ----------------
# 팀원마다 각자 로컬 MySQL 을 쓴다. 아래는 본인 PC 기준.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=newsletter

# ---------------- 메일 발송 ----------------
# 이번 프로젝트는 한 사람에게만 보낸다. 구독자 관리 DB 를 만들지 않는다.
MAIL_TO=contact@1435.co.kr
MAIL_DRY_RUN=true          # true 면 실제로 보내지 않고 기록만 남긴다
